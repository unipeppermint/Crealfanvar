# macOS
.DS_Store
._*
.AppleDouble
.LSOverride

# Xcode build products and local user settings
build/
DerivedData/
xcuserdata/
*.xcuserstate
*.xccheckout
*.xcscmblueprint
*.hmap

# Archives, exported apps, and debug symbols
*.xcarchive/
*.ipa
*.app/
