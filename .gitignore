# macOS
.DS_Store
._*
.AppleDouble
.LSOverride

# Xcode build products and local user settings
build/
DerivedData/
xcuserdata/
*.xcuserstate
*.xccheckout
*.xcscmblueprint
*.hmap

# Archives, exported apps, and debug symbols
*.xcarchive/
*.ipa
*.app/
*.dSYM/
*.dSYM.zip

# Test results and coverage
*.xcresult/
*.profdata
*.profraw
*.gcda
*.gcno
# Generated QA media, logs, save fixtures, and reports stay local.
/artifacts/screenshots/
/artifacts/validation/*
!/artifacts/validation/CFV-Level-Design-Witnesses.json
!/artifacts/validation/CFV-Expansion-Design-Witnesses.json
!/artifacts/validation/CFV-Reference-Solutions.txt
/artifacts/*.mp4
/artifacts/*.mov
/artifacts/*.png
/artifacts/retired-polygon-art/
/docs/*.zip
/docs/archive/
/design/prototypes/archive/

# Swift Package Manager build cache (keep Package.resolved)
.build/

# Python helper script caches
__pycache__/
*.py[cod]
.venv/

# Editor temporary files
*.swp
*.swo
*~
