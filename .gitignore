# Test results and coverage
*.xcresult/
*.profdata
*.profraw
*.gcda
*.gcno
/artifacts/validation/*.log
/artifacts/validation/save-fixtures-*/

# Swift Package Manager build cache (keep Package.resolved)
.build/

# Python helper script caches
__pycache__/
*.py[cod]
.venv/

# Editor temporary files
*.swp
*.swo
*~
